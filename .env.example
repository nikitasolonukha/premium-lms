# Copy to .env.local. npm run setup:local fills values from your LOCAL Supabase.
DEPLOYMENT_ENV=local
# staging / production require HTTPS for both URLs, without localhost exceptions.
APP_URL=http://localhost:3000
# Optional standalone bind address; keep loopback for local work.
LMS_HOST=127.0.0.1
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
# Generate 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional trusted proxy IP header; configure only when the proxy overwrites it.
TRUSTED_IP_HEADER=
TRUSTED_PROXY_ACKNOWLEDGED=false
# Set true only when your proxy removes and overwrites this header and Node is private.
# Provider credentials are server-only, all-or-nothing for each provider.
VIDEO_PROVIDER=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_PLAYBACK_HOST=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Operator scripts / local QA only. The running web app never needs DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Test-only credentials are generated into .local/seed-accounts.json (gitignored).
## Live protected-video QA only: private test assets, never production content.
QA_CLOUDFLARE_VIDEO_ID=
QA_MUX_PLAYBACK_ID=
