# Copy to .env.local. npm run setup:local fills values from your LOCAL Supabase.
APP_URL=http://localhost:3000
# Optional standalone bind address; keep loopback for local work.
LMS_HOST=127.0.0.1
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
# Optional trusted proxy IP header; configure only when the proxy overwrites it.
TRUSTED_IP_HEADER=
# Operator scripts / local QA only. The running web app never needs DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Test-only credentials are generated into .local/seed-accounts.json (gitignored).
